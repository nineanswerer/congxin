# 「从心」后端环境变量
#
# ⚠️ 这些值**只在服务端**。密钥绝不进仓库、绝不进前端响应、绝不进日志。
# 复制成 .env 后填入；.env 已在 .gitignore 里。

# 端口。AI Works 部署时平台会注入 PORT，这里只是本地默认值。
PORT=8787

# 知乎开放平台 Access Secret（必需）。
# 获取地址：https://developer.zhihu.com/profile
# 开发期用它读**你自己的**账号数据；12-05 拿到 App ID / App Key 后，
# 换成 OAuth 读登录用户的数据，**接口形状相同，不返工**。
ZHIHU_ACCESS_SECRET=

# OAuth Token（可选）。设置后行为接口改为读**登录用户**的数据，
# 需要同时设置下面的 App ID / Key。
ZHIHU_OAUTH_TOKEN=
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=

# OAuth 授权回调地址。**必须与赛事页面登记值逐字符一致**
# （协议 / 域名 / 端口 / 路径 / 尾部斜杠 / Query 都算）。
# App ID 与 App Key 由**赛事页面在项目创建后**分配，不走通用邮件申请流程。
ZHIHU_OAUTH_REDIRECT_URI=

# 授权成功后回前端的地址（302 落点）。留空则回站点根。
FRONT_ORIGIN=

# 会话 Cookie 是否加 Secure。生产默认 true；本地 http 调试可设 false。
# OAuth Token 只在服务端，浏览器拿到的只有 HttpOnly Cookie 里的随机 session id。
SESSION_COOKIE_SECURE=

# 缓存有效期（毫秒）。默认 5 分钟。
# 官方把「请求缓存 + 去重」写成最佳实践，本届更是生死线：
# 额度虽然已经实名认证拉满，但重复调用既浪费也容易触发秒级限流。
CACHE_TTL_MS=300000

# 上游请求超时（毫秒）。默认 10 秒。
UPSTREAM_TIMEOUT_MS=10000

# 上游秒级限流的退避基数（毫秒）。实测上游返回 Code=30001
# "second limit exceeded"，需要退避重试。
RETRY_BASE_MS=1200
